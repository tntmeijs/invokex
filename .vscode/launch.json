{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Control Plane",
            "type": "go",
            "request": "launch",
            "mode": "auto",
            "program": "${workspaceRoot}/src/control",
            "args": ["--invokex-config", "${workspaceRoot}/invokex.json"],
            "cwd": "${workspaceRoot}"
        },
        {
            "name": "Processor",
            "type": "go",
            "request": "launch",
            "mode": "auto",
            "program": "${workspaceRoot}/src/processor",
            "args": ["--invokex-config", "${workspaceRoot}/invokex.json"],
            "cwd": "${workspaceRoot}"
        }
    ],
    "compounds": [
        {
            "name": "All",
            "configurations": [
                "Control Plane",
                "Processor"
            ],
            "stopAll": true
        }
    ]
}